# ── App ────────────────────────────────────────────────────────
APP_NAME=CIELO·TUC
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_openssl_rand_hex_32

# ── Database (PostgreSQL + PostGIS) ────────────────────────────
DATABASE_URL=postgresql+asyncpg://cielotuc:password@localhost:5432/cielotuc
DATABASE_URL_SYNC=postgresql://cielotuc:password@localhost:5432/cielotuc

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── External APIs ───────────────────────────────────────────────
SMN_API_URL=https://ws.smn.gob.ar/map_items/weather
NASA_GPM_BASE_URL=https://gpm.nasa.gov/api/v1
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal
ERA5_API_KEY=YOUR_COPERNICUS_API_KEY

# ── Notifications (Twilio) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_TOKEN
TWILIO_FROM_PHONE=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── MLflow ──────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=cielotuc-weather-lstm

# ── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── FLOOD·TUC connection ────────────────────────────────────────
FLOODTUC_API_URL=http://localhost:8001
FLOODTUC_API_KEY=SHARED_SECRET_KEY
FLOODTUC_ALERT_THRESHOLD_MM=70.0
